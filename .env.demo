# ============================================================================
# PERFIL DE DEMONSTRACAO — 100% DADOS FICTICIOS
# ============================================================================
# Este arquivo existe para rodar a aplicacao LOCALMENTE com dados inventados,
# para gravar video e tirar print sem expor CPF, telefone ou voto de socio
# real. Ele e versionado de proposito: nao ha nenhum segredo aqui.
#
# NAO USE EM PRODUCAO. DEBUG=true faz o provider de OTP escrever o codigo em
# texto puro no log da aplicacao e o reCAPTCHA passar sem validar.
#
# Lido direto pelo docker-compose.demo.yml. NAO copie por cima do .env
# real: ele tem as credenciais de producao. Ver docs/DEMO.md.
# ============================================================================

APP_NAME=SEMPRE TRICOLOR
APP_ENV=development
DEBUG=true

# Chave gerada so para a demo, descartavel. O .env real tem outra.
SECRET_KEY=jOrY-4yn1n4Go1MgPSjIovQWtXVJKP1wQiVROVWEtvT_w1FmlJT9fJfgYEdf3ljW

# Porta 8080 e nao 8000: o stack de desenvolvimento normal ja ocupa a 8000,
# e a ideia e os dois poderem rodar ao mesmo tempo.
ALLOWED_ORIGINS=http://localhost:8080

POSTGRES_USER=demo
POSTGRES_PASSWORD=demo
POSTGRES_DB=sondagem_demo

DATABASE_URL=postgresql+asyncpg://demo:demo@db:5432/sondagem_demo
DATABASE_URL_SYNC=postgresql+psycopg2://demo:demo@db:5432/sondagem_demo

REDIS_PASSWORD=demo
REDIS_URL=redis://:demo@redis:6379/0

# mock: nao envia SMS, escreve o codigo no log do container. E o unico
# provider que funciona sem contratar ninguem, e ele se recusa a rodar
# fora de DEBUG=true (ver app/integrations/otp_providers.py).
OTP_PROVIDER=mock
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Sem credencial de provedor de SMS. Nenhuma mensagem sai daqui.
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=SEMPRE TRICOLOR

# Vazio + DEBUG=true = reCAPTCHA desligado. Fora de DEBUG ele falha fechado.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=

# Senha da demo: demo1234  (hash bcrypt abaixo)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=$2b$12$.s3qGgc6SjM1SacVvyX3DuyktXZu3jjkZDSQMqaYazTsIr1053qCi

# Limites folgados: numa gravacao de tela voce repete o fluxo varias vezes
# seguidas do mesmo IP, e o limite de producao te barraria no meio do take.
RATE_LIMIT_DEFAULT=1000/minute
RATE_LIMIT_OTP=100/minute
RATE_LIMIT_VALIDATE_CPF=300/minute
RATE_LIMIT_REGISTER=100/minute
RATE_LIMIT_VERIFY_OTP=100/minute
RATE_LIMIT_RESEND_OTP=100/minute
RATE_LIMIT_SUBMIT=100/minute
RATE_LIMIT_ADMIN_LOGIN=50/minute

HTTPS_ONLY=false
TRUST_PROXY_HEADERS=false

UPLOAD_DIR=uploads/candidatos
MAX_UPLOAD_SIZE_MB=5
